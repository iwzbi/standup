{
  "$schema": "opencode.ai/config.json",
  "model": "idealab/deepseek-v4.1-flash",
  "provider": {
    "idealab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "idealab.alibaba-inc.com",
      "options": {
        "baseURL": "https://lab22-it-ai.eng.xrvm.cn/v1",
        "apiKey": "{file:~/.secrets/idealab.key}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "_launch": true,
          "name": "deepseek-v4.1-flash"
        },
        "glm-5.3": {
          "_launch": true,
          "name": "glm-5.3"
        },
      }
    }
  },
  "plugin": [
    "opencode-pty",
    "oh-my-openagent@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp",
    "@mohak34/opencode-notifier",
    "opencode-vibeguard",
    "opencode-scheduler",
    "opencode-goal-plugin"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -rf": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask"
    }
  }
}
